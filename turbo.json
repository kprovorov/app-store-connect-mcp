{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DATABASE_URL", "ENCRYPTION_KEYS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "WEB_ORIGIN", "CLERK_PUBLISHABLE_KEY", "CLERK_SECRET_KEY"]
    },
    "typecheck": {},
    "lint": {},
    "test": {},
    "test:db": {
      "cache": false
    }
  }
}
