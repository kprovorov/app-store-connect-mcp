# Copy to .env and fill in. Later phases add the variables they need.

# Master keys for encrypting ASC private keys, as a comma list of <version>:<base64 32 bytes>.
# The highest version encrypts new secrets; older versions stay to decrypt existing ones.
# Generate a key with: pnpm --filter @asc-mcp/crypto gen-key
ENCRYPTION_KEYS=1:

# Postgres connection for @asc-mcp/db. `supabase start` prints this local URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Clerk keys for the development instance: Clerk Dashboard > API keys, or `clerk env pull`.
# api and mcp verify tokens with them; mcp also derives the OAuth issuer from the publishable key.
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# Origin of the web app. api allows CORS and Clerk session tokens (azp) only from here.
WEB_ORIGIN=http://localhost:3000

# Port for api (defaults to 8787) or mcp (defaults to 8788). Set it per process, not here.
# PORT=
